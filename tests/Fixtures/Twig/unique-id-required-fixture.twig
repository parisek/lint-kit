<section class="component-product-slider">
	{% for slide in content.slides %}
		{% set slider_id = 'product-slider-' ~ loop.index %}

		<div id="{{ slider_id }}" aria-controls="thumbs-{{ loop.index }}" class="swiper">
			{% for item in slide.items %}
				<article class="swiper-slide">
					<label for="slide-toggle-{{ loop.index }}">{{ item.title }}</label>
					<input type="checkbox" name="active-slide-{{ loop.index }}" id="slide-toggle-{{ loop.index }}">
				</article>
			{% endfor %}
		</div>

		<nav aria-labelledby="{{ slider_id }}-label">
			<button aria-controls="{{ slider_id }}">prev</button>
			<button aria-controls="{{ slider_id }}">next</button>
		</nav>
	{% endfor %}
</section>
