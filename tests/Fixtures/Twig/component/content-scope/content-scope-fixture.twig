{# --- SHOULD FIRE: read from whatever context the caller happened to have --- #}

{% if caller_flag %}
	<p>This renders differently depending on where the component is used.</p>
{% endif %}

<h2>{{ outer_title }}</h2>

{{ component_button({ title: stray_option }) }}

{# --- SHOULD NOT FIRE: everything below is either passed, bound or ambient --- #}

{# content and anything under it is the component's own input #}
<h3>{{ content.title }}</h3>
{% if content.items %}
	{# {% for %} targets, both the one-name and key/value forms #}
	{% for item in content.items %}
		<span>{{ item.label }}</span>
	{% endfor %}
	{% for index, entry in content.items %}
		<span>{{ index }}: {{ entry.label }}</span>
	{% endfor %}
{% endif %}

{# {% set %}, in both the assignment and capture forms #}
{% set computed = content.title|upper %}
{{ computed }}
{% set captured %}
	<em>{{ content.title }}</em>
{% endset %}
{{ captured }}

{# imported macro namespace #}
{% import '@macro/icons/icons.twig' as icons %}
{{ icons.get('ico-basic-check') }}

{# arrow-function parameters bind for the callback's own scope #}
