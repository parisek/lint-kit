{# === OK 7: _n with |format === #}
<div aria-label="{{ _n('%d day', '%d days', count, 'tailwind-base')|format(count) }}"></div>

{# === OK 8: no placeholder at all — the count is printed by the surrounding markup === #}
<div aria-label="{{ count }} {{ _nx('day', 'days', count, 'tailwind-base', 'tailwind-base') }}"></div>

{# === OK 9: no placeholder — forms handed to JavaScript, which selects per tick via Intl.PluralRules === #}
<div data-one="{{ _n('day', 'days', 1, 'tailwind-base') }}" data-few="{{ _n('day', 'days', 2, 'tailwind-base') }}" data-many="{{ _n('day', 'days', 5, 'tailwind-base') }}"></div>

{# === OK 10: escaped percent is not a placeholder === #}
