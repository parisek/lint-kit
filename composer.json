{
    "name": "parisek/lint-kit",
    "description": "Twig and PHPStan lint rules for WordPress and Drupal projects: a CMS-neutral core and one opt-in rule set per CMS.",
    "license": [
        "MIT"
    ],
    "type": "library",
    "require": {
        "php": ">=8.3",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0",
        "twig/twig": "^3.30",
        "vincentlanglet/twig-cs-fixer": "^4.1.1"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.54",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "suggest": {
        "phpstan/extension-installer": "Loads the PHPStan rules of this package without a manual include."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Parisek\\LintKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Parisek\\LintKit\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=1G --no-progress",
        "test": "phpunit"
    }
}
