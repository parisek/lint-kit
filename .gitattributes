# Distribution scope: Composer builds the archive of a tag from git, so only what a project runs
# reaches vendor/. A first install showed tests/, docs/ and AGENTS.md arriving without this file.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.editorconfig      export-ignore
/docs               export-ignore
/tests              export-ignore
/phpunit.xml.dist   export-ignore
/AGENTS.md          export-ignore
/CLAUDE.md          export-ignore
/CONTRIBUTING.md    export-ignore
/SECURITY.md        export-ignore
/RELEASING.md       export-ignore
/CHANGELOG.md       export-ignore
/phpstan.neon       export-ignore
/phpstan-baseline.neon export-ignore
