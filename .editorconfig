root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

# Moved rules keep the tab indentation of the upstream files, so a diff against them stays readable.
[src/**/Rules/*.php]
indent_style = tab
